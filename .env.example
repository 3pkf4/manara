# ===== قاعدة البيانات =====
# على الاستضافات السحابية استعمل DATABASE_URL بدل DB_* (مثل postgresql://user:pass@host/db). DB_SSL=true للاتصال الخارجي المشفر
DATABASE_URL=
DB_SSL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manara_db
DB_USER=manara
DB_PASSWORD=ضع_كلمة_مرور_قوية_هنا

# ===== الأمان (إلزامي) =====
# ولّد سراً بالأمر:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=12h
BCRYPT_ROUNDS=10

# ===== الخادم =====
NODE_ENV=production
PORT=3000
# 127.0.0.1 = محلي فقط (الأفضل خلف Nginx/Cloudflare). 0.0.0.0 = متاح على الشبكة
HOST=127.0.0.1
# عدد الوسطاء الموثوقين أمام التطبيق (Cloudflare Tunnel/Nginx = 1). مهم لتحديد IP الحقيقي
TRUST_PROXY=1
# نطاقات مسموحة للـ CORS (مفصولة بفواصل). اتركه فارغاً لنفس الأصل فقط
CORS_ORIGINS=
# تطبيق الهجرات تلقائياً عند الإقلاع
AUTO_MIGRATE=true
# مدة الفترة التجريبية للمتاجر الجديدة (أيام)
DEFAULT_TRIAL_DAYS=14

# ===== حساب المالك (يُستعمل مرة عند: npm run init-db) =====
# 10 أحرف فأكثر. إن تُرك فارغاً تُولَّد كلمة عشوائية وتُطبع مرة واحدة
OWNER_EMAIL=
OWNER_PASSWORD=

# ===== الدفع الإلكتروني MyPay (اختياري) =====
# جرّب أولاً على Sandbox: https://mypay.ly/pay/sandbox/api/v1  ثم بدّل للإنتاج: https://mypay.ly/pay/api/v1
MYPAY_BASE_URL=https://mypay.ly/pay/sandbox/api/v1
MYPAY_CLIENT_ID=
MYPAY_CLIENT_SECRET=
# سرّ التوقيع من لوحة MyPay (قسم Webhooks). عنوان الإشعارات: PUBLIC_BASE_URL/api/payments/webhook
MYPAY_WEBHOOK_SECRET=
# عنوان موقعك العام (https) — تعود إليه صفحة الدفع
PUBLIC_BASE_URL=

# ===== واجهة الدعم للمالك (لوحة Apps Script) — اختياري =====
# 40 حرفاً فأكثر. بدونه تبقى واجهة /api/ops معطّلة. ولّده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_API_KEY=

# مدة جلسة الدخول بـ QR (اختياري)
# QR_SESSION_EXPIRY=7d

# رقم واتساب للدعم وشراء الأكواد (يظهر في شاشة القفل)
# SUPPORT_WHATSAPP=218922227299
